flowchart LR
  subgraph Sources["Recall sources (keyless, public)"]
    S1["Forwarded alert / pasted URL / PDF<br/>(the notice the food bank already gets)"]
    S2["FDA press-release RSS<br/>(same day) + press page"]
    S3["openFDA enforcement<br/>(weekly ledger: sweep + enrichment)"]
  end

  subgraph Intake["Deterministic intake (no model)"]
    I1["fetch_url<br/>browser UA, cache, abuse-wall detect"]
    I2["parse_fda_press_page / parse_text<br/>UPCs as printed, lots, best-by,<br/>states, disposition verbatim"]
    I3["to_recall_notice<br/>confidence below 0.8 goes to the Extractor agent"]
  end

  subgraph Strands["Strands Agents (orchestrator + agents-as-tools)"]
    O["Orchestrator Agent<br/>@tool functions run the procedure"]
    T1["score_candidates<br/>rules 3/4/7/8, rapidfuzz, top-k only"]
    M["Matcher agent-as-tool<br/>structured_output: MatchVerdict<br/>MATCH / NO_MATCH / NEEDS_HUMAN"]
    W["Notice writer agent-as-tool<br/>structured_output: AgencyNotice, ClientSign<br/>(disposition copied verbatim)"]
    H["Hooks<br/>AuditHook: audit row per tool call<br/>ApprovalGuard: cancel send_notices<br/>unless approved_at<br/>TerminalToolGuard: end the run<br/>after the decision"]
  end

  subgraph Register["System of record (FastAPI + SQLite)"]
    L["Receiving ledger<br/>+ distribution log"]
    C["Recall case register<br/>verdicts, pull list, HOLD tags,<br/>notices, responses, follow-ups, audit"]
    D["Coordinator decisions<br/>(remembered, rule 14)"]
  end

  subgraph People["The people"]
    K["Coordinator<br/>ONE decision per case:<br/>Send?"]
    A["Partner pantries<br/>(12 agencies, volunteer-run)<br/>one click: pulled / never received /<br/>already distributed / need pickup"]
    P["Households<br/>shelf sign EN / ES / HT"]
  end

  subgraph AWS["AWS (packaged; the demo host runs the same code)"]
    R["Amazon Bedrock AgentCore Runtime<br/>CodeZip package, stateless<br/>calls the register over REST"]
    B["Amazon Bedrock<br/>Claude via Strands BedrockModel<br/>(demo: same model via an OpenAI-compatible endpoint)"]
  end

  S1 --> I1
  S2 --> I1
  S3 -- notice_from_openfda --> O
  I1 --> I2 --> I3 --> O
  O --> T1 --> M
  O --> W
  H -. guards .- O
  L --> T1
  M --> C
  W --> C
  D --> M
  C --> K
  K -- approve --> C
  C -- notices + follow-ups --> A
  A -- responses --> C
  A -- already distributed --> P
  C --> X["Audit packet<br/>(PDF, on close)"]
  R --- O
  B --- O
