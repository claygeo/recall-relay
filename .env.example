# Copy to .env and fill in ONE model provider. Every variable the app reads is listed here;
# the ones marked optional fall back to the defaults in app/recall_relay/core/config.py.

# --- model -----------------------------------------------------------------
MODEL_PROVIDER=openrouter            # openrouter | anthropic | bedrock
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
AWS_REGION=us-east-1                 # bedrock only
ORCHESTRATOR_MODEL=                  # optional: override the per-provider default model id
MATCHER_MODEL=                       # optional
WRITER_MODEL=                        # optional

# --- the food bank ---------------------------------------------------------
FOOD_BANK_NAME=South Dade Community Food Bank
FOOD_BANK_STATE=FL
COORDINATOR_EMAIL=coordinator@example.org

# --- storage ---------------------------------------------------------------
RECALL_RELAY_DB=                     # optional path to the SQLite file; default data/runtime/recall_relay.db
RECALL_RELAY_CACHE=                  # optional path for fetched pages; default data/runtime/cache

# --- email -----------------------------------------------------------------
EMAIL_BACKEND=mirror                 # mirror (implemented) | ses | resend (stubs)
EMAIL_FROM=recall-relay@example.org
RESEND_API_KEY=                      # resend and ses backends are stubs; mirror is the only implemented backend

# --- web -------------------------------------------------------------------
PUBLIC_BASE_URL=http://127.0.0.1:8000
SECRET_KEY=change-me

# --- agent backend ---------------------------------------------------------
AGENT_BACKEND=inprocess              # inprocess | remote
AGENT_DATA_URL=                      # dashboard base URL the Runtime calls when AGENT_BACKEND=remote
AGENT_DATA_SECRET=                   # shared secret for /api/data/rpc (Runtime -> dashboard)
MAX_AGENT_RUNS_PER_DAY=10            # the public demo runs with 4

# --- fetch -----------------------------------------------------------------
FETCH_USER_AGENT=                    # optional: override the browser UA used to fetch press pages
