# Copy to .env and fill in ONE model provider.
MODEL_PROVIDER=openrouter            # openrouter | anthropic | bedrock
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
AWS_REGION=us-east-1
# ORCHESTRATOR_MODEL= / MATCHER_MODEL= / WRITER_MODEL=   (optional overrides)
FOOD_BANK_NAME=South Dade Community Food Bank
FOOD_BANK_STATE=FL
COORDINATOR_EMAIL=coordinator@example.org
EMAIL_BACKEND=mirror                 # mirror | ses | resend
EMAIL_FROM=recall-relay@example.org
PUBLIC_BASE_URL=http://127.0.0.1:8000
SECRET_KEY=change-me
AGENT_BACKEND=inprocess              # inprocess | agentcore
AGENTCORE_RUNTIME_ARN=
AGENT_DATA_SECRET=                   # shared secret for /api/data/rpc (Runtime -> dashboard)
MAX_AGENT_RUNS_PER_DAY=60
